      "quality_focus": ["temporal_consistency", "coordinate_validation", "sensor_calibration", "missing_telemetry"],
      "benchmarks": {
        "acceptable_missing_rate": 2,
        "coordinate_precision_digits": 6,
        "temporal_gap_threshold_seconds": 60
      },
      "recommendations": [
        "Validate coordinate ranges: Lat [-90,90], Lon [-180,180]",
        "Check for telemetry gaps > 60s which may indicate communication loss",
        "Verify sensor readings against calibration bounds",
        "Flag altitude values outside expected orbital range"
      ]
